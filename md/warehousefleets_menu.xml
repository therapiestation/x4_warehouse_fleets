<?xml version="1.0" encoding="utf-8"?>
<mdscript name="WarehouseFleetsMenu" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/home/manuel/Nextcloud/X4 Foundations/2026-02-28/libraries/md.xsd">
  <cues>
    <cue name="StartSMO" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_Options.Reloaded" />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
          param="table[
            $id = 'WarehouseFleetsConfigMenu',
            $columns = 2,
            $title = {1779100, 200},
            $onOpen = BuildWarehouseFleetConfigMenu,
          ]" />
        <cancel_cue cue="this" />
      </actions>
    </cue>
    <cue name="BuildWarehouseFleetConfigMenu" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>

        <signal_cue_instantly cue="AddEmptyRow" />
        <signal_cue_instantly cue="AddCenteredTextRow" param="table[$text={1779100, 201}]" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[
          $id = 'accountThreshold', $min = 0, $max = 100, $suffix = 'M', $default = 1, $text = {1779100, 202}, 
          $mouseOverText = {1779100, 203}
        ]" />

        <signal_cue_instantly cue="AddCheckboxRow" param="table[
          $id = 'transferToPlayer', $default = false, $text = {1779100, 204}, 
          $mouseOverText = {1779100, 205},
        ]" />

        <signal_cue_instantly cue="AddDropdownRow" param="table[
          $id = 'failedOrderHandling',
          $options = [
            table[$text={1779100, 208}, $value=1],
            table[$text={1779100, 209}, $value=2],
            table[$text={1779100, 210},  $value=3],
            table[$text={1779100, 211},   $value=4],
            table[$text={1779100, 212},     $value=5]
          ],
          $text = {1779100, 206},
          $mouseOverText = {1779100, 207},
        ]" />

        <signal_cue_instantly cue="AddDropdownRow" param="table[
          $id = 'fleetOrganization',
          $options = [
            table[$text={1779100, 215}, $value=1],
            table[$text={1779100, 216}, $value=2]
          ],
          $text = {1779100, 213},
          $mouseOverText = {1779100, 214},
        ]" />

        <signal_cue_instantly cue="AddEmptyRow" />
        <signal_cue_instantly cue="AddEmptyRow" />
        <signal_cue_instantly cue="AddCenteredTextRow" param="table[$text={1779100, 220}]" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[ $id = 'minCargoUsage', $min = 0, $max = 90, $suffix = '%', $default = 50, $text = {1779100, 113}, $mouseOverText = {1779100, 231} ]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'minCargoUsage']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[ $id = 'tradeGatePenalty', $min = 0, $max = 90, $suffix = '%', $default = 20, $text = {1779100, 115}, $mouseOverText = {1779100, 232} ]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'tradeGatePenalty']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[ $id = 'miningGatePenalty', $min = 0, $max = 90, $suffix = '%', $default = 20, $text = {1779100, 116}, $mouseOverText = {1779100, 233} ]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'miningGatePenalty']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioDistribution', $min = 0, $max = 10, $suffix = '', $default = 5, $text = {1779100, 106}, $mouseOverText = {1779100, 234}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioDistribution']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioStations', $min = 0, $max = 10, $suffix = '', $default = 5, $text = {1779100, 107}, $mouseOverText = {1779100, 235}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioStations']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioTrade', $min = 0, $max = 10, $suffix = '', $default = 5, $text = {1779100, 108}, $mouseOverText = {1779100, 236}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioTrade']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioSellOut', $min = 0, $max = 10, $suffix = '', $default = 5, $text = {1779100, 109}, $mouseOverText = {1779100, 237}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioSellOut']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'sellOutKeep', $min = 0, $max = 100, $suffix = '%', $default = 100, $text = {1779100, 114}, $mouseOverText = {1779100, 238}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'sellOutKeep']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioSupply', $min = 0, $max = 10, $suffix = '', $default = 5, $text = {1779100, 110}, $mouseOverText = {1779100, 239}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioSupply']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioBuild', $min = 0, $max = 10, $suffix = '', $default = 7, $text = {1779100, 111}, $mouseOverText = {1779100, 240}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioBuild']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddSliderRow" param="table[$id = 'prioMining', $min = 0, $max = 10, $suffix = '', $default = 4, $text = {1779100, 112}, $mouseOverText = {1779100, 241}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'prioMining']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddCheckboxRow" param="table[$id = 'waitInDockS', $default = true, $text = {1779100, 117}, $mouseOverText = {1779100, 242}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'waitInDockS']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddCheckboxRow" param="table[$id = 'waitInDockM', $default = true, $text = {1779100, 118}, $mouseOverText = {1779100, 243}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'waitInDockM']" />
        <signal_cue_instantly cue="AddEmptyRow" />

        <signal_cue_instantly cue="AddCheckboxRow" param="table[$id = 'waitInDockL', $default = false, $text = {1779100, 119}, $mouseOverText = {1779100, 244}]" />
        <signal_cue_instantly cue="AddSyncButtonRow" param="table[$id = 'waitInDockL']" />
        <signal_cue_instantly cue="AddEmptyRow" />
      </actions>
    </cue>

    <cue name="AddEmptyRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable=false]" />
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col=1, $colSpan=2, $halign='center', $text=' ']" />
      </actions>
    </cue>

    <cue name="AddCheckboxRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" />
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $text = event.param.$text]" />
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_CheckBox"
          param="table[
            $col = 2,
            $id = event.param.$id,
            $checked = global.$WarehouseFleets.{'$' + event.param.$id},
            $width = 'Helper.standardButtonHeight',
            $height = 'Helper.standardButtonHeight',
            $default = event.param.$default,
            $mouseOverText = event.param.$mouseOverText,
            $onClick = OnUpdateCheckbox,
          ]"
        />
      </actions>
    </cue>

    <cue name="AddSliderRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" />
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $text = event.param.$text]" />
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Slider"
          param="table[
            $col = 2,
            $id = event.param.$id,
            $start = global.$WarehouseFleets.{'$' + event.param.$id},
            $min = event.param.$min,
            $max = event.param.$max,
            $suffix = event.param.$suffix,
            $default = event.param.$default,
            $mouseOverText = event.param.$mouseOverText,
            $onSliderCellConfirm = OnUpdateSlider,
          ]"
        />
      </actions>
    </cue>

    <cue name="AddDropdownRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" />
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[$col = 1, $text = event.param.$text]" />
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Dropdown"
          param="table[
            $col = 2,  
            $id = event.param.$id,
            $options = event.param.$options,
            $startOption = global.$WarehouseFleets.{'$' + event.param.$id},
            $mouseOverText = event.param.$mouseOverText,
            $onDropDownConfirmed = OnUpdateDropdown,
          ]" />
      </actions>
    </cue>

    <cue name="AddSyncButtonRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" />
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 2,
            $id = event.param.$id,
            $text = table[$text={1779100, 221}],
            $mouseOverText = {1779100, 222},
            $onClick = OnSyncButtonPressed
          ]"
        />
      </actions>
    </cue>

    <cue name="AddCenteredTextRow" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" />
        <signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
          $col = 1,
          $colSpan = 2,
          $halign = 'center',
          $text = event.param.$text,
        ]" />
      </actions>
    </cue>

    <cue name="OnSyncButtonPressed" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <find_ship_by_true_owner space="player.galaxy" faction="faction.player" multiple="true" name="$ships" />
        <do_for_each in="$ships" name="$ship">
          <do_if value="$ship.defaultorder != null and $ship.defaultorder.id == 'WarehouseFleet'">
            <edit_order_param order="$ship.defaultorder" param="event.param.$id" value="global.$WarehouseFleets.{'$' + event.param.$id}" />
          </do_if>
        </do_for_each>
      </actions>
    </cue>

    <cue name="OnUpdateCheckbox" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <set_value name="global.$WarehouseFleets.{'$' + event.param.$id}" exact="event.param.$checked" />
      </actions>
    </cue>

    <cue name="OnUpdateDropdown" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <set_value name="global.$WarehouseFleets.{'$' + event.param.$id}" exact="event.param.$option.$value" />
        <do_if value="event.param.$id == 'fleetOrganization'">
          <signal_cue_instantly cue="md.WarehouseFleets.UpdateFleetOrganization" />
        </do_if>
      </actions>
    </cue>

    <cue name="OnUpdateSlider" instantiate="true">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <set_value name="global.$WarehouseFleets.{'$' + event.param.$id}" exact="event.param.$value" />
      </actions>
    </cue>

  </cues>
</mdscript>